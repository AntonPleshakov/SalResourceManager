    {"datasource":{"type":"prometheus","uid":"prometheus"},"description":"Доля webhook, для которых действительно был запущен handler. Низкое значение обычно означает служебный или неподходящий трафик Telegram.","fieldConfig":{"defaults":{"color":{"fixedColor":"blue","mode":"fixed"},"decimals":1,"max":100,"min":0,"unit":"percent"},"overrides":[]},"gridPos":{"h":4,"w":4,"x":20,"y":0},"id":6,"options":{"colorMode":"value","graphMode":"none","reduceOptions":{"calcs":["lastNotNull"],"fields":"","values":false}},"targets":[{"expr":"100 * (sum(increase(srm_handler_calls_total[$__range])) or vector(0)) / clamp_min(sum(increase(srm_requests_total[$__range])), 1)","instant":true,"legendFormat":"Полезные webhook","range":false,"refId":"A"}],"title":"Полезные webhook","type":"stat"},

